NODE_ENV=development
PORT=5050
# Prisma Postgres → Connect → direct (postgres://) connection string
DATABASE_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=verify-full"
CLIENT_URL=http://localhost:3000

# Auth
BCRYPT_SALT_ROUNDS=12
JWT_ACCESS_SECRET=replace-with-64-random-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-64-random-chars
JWT_REFRESH_EXPIRES_IN=7d

# Stripe (test mode): Dashboard → Developers → API keys. Products and prices are created by
# `npm run stripe:setup`, which stores their ids in the plans table (no price ids here)
STRIPE_SECRET_KEY=sk_test_xxx
# Printed by `stripe listen` locally; Dashboard → Webhooks → endpoint → Signing secret in production
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_METER_EVENT_NAME=ledgerflow_units

# Email (Mailtrap in development)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
MAIL_FROM="LedgerFlow <no-reply@ledgerflow.dev>"

# Jobs
ENABLE_JOBS=true
# Secret for /api/v1/internal/jobs/* (required in production): openssl rand -hex 32
CRON_SECRET=
# Number of proxies in front of the API (1 locally: the Next.js dev rewrite)
TRUST_PROXY=1
GRACE_PERIOD_DAYS=7

# Seed (super admin login)
SUPER_ADMIN_EMAIL=admin@ledgerflow.dev
SUPER_ADMIN_PASSWORD=change-me
