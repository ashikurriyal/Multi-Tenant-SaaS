NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ledgerflow
CLIENT_URL=http://localhost:3000

# Auth
BCRYPT_SALT_ROUNDS=12
JWT_ACCESS_SECRET=replace-with-64-random-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-64-random-chars
JWT_REFRESH_EXPIRES_IN=7d

# Stripe (test mode)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_METER_EVENT_NAME=ledgerflow_units

# Email (Mailtrap in development)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
MAIL_FROM="LedgerFlow <no-reply@ledgerflow.dev>"

# Jobs
ENABLE_JOBS=true
GRACE_PERIOD_DAYS=7
